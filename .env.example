# ================================================
# LangGraph 智能客服系统 — 环境变量配置
# ================================================
# 使用说明:
#   1. 复制此文件并重命名为 .env
#   2. 填写下方对应的 API Key 和配置项
#   3. 请勿将 .env 文件提交到版本控制系统
# ================================================

# ── LLM Chat 模型配置（支持 DeepSeek / 百炼 / OpenAI 等任意 OpenAI 兼容 API）──
LLM_API_KEY=your-chat-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ── Embedding 模型配置（向量检索用，独立于 Chat 模型）──
# 阿里云百炼 DashScope API Key — 用于 text-embedding-v2
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ── 服务端口配置 ──
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── 知识库路径 ──
KNOWLEDGE_BASE_PATH=data/knowledge_base.txt
